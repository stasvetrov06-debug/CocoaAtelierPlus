@model List<CocoaAtelierPlus.Models.AppUser>
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="section-title mb-0">Учетные записи</h1>
    <a class="btn btn-accent" asp-controller="User" asp-action="Create">Добавить пользователя</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">Список пользователей пуст.</div>
}
else
{
    <div class="table-card">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Логин</th>
                    <th>ФИО</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Login</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.RoleName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-badge active">Активен</span>
                            }
                            else
                            {
                                <span class="status-badge blocked">Заблокирован</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-outline-accent btn-sm"
                               asp-controller="User" asp-action="Edit" asp-route-id="@item.UserId">Изменить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
