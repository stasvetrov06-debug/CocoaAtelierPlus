@model List<CocoaAtelierPlus.Models.SupplierItem>
@{
    ViewData["Title"] = "Поставщики материала";
    var materialName = ViewBag.MaterialName as string ?? string.Empty;
}

<nav class="mb-3">
    <a asp-controller="Material" asp-action="Index" class="back-link">&larr; Назад к списку материалов</a>
</nav>

<h1 class="section-title">Поставщики выбранного материала</h1>
<p class="material-subtitle">Материал: <strong>@materialName</strong></p>

@if (!Model.Any())
{
    <div class="empty-state">
        Для данного материала поставщики не назначены. Обратитесь к администратору системы.
    </div>
}
else
{
    <div class="table-card">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Наименование поставщика</th>
                    <th>Рейтинг</th>
                    <th>Дата начала работы</th>
                    <th class="text-end">Закупочная цена</th>
                    <th class="text-end">Срок поставки, дней</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>
                            <span class="rating-badge">@item.Rating</span>
                        </td>
                        <td>@item.StartDate</td>
                        <td class="text-end">@item.PurchasePrice.ToString("0.00") руб.</td>
                        <td class="text-end">@item.DeliveryDays</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
